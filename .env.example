# 复制成 .env 后按需修改。.env 已被 .gitignore 排除，不会提交。

# 预构建镜像地址：填了就 `docker compose pull && docker compose up -d`，不用本地编译。
# 换成你自己的 GitHub 用户名 / 仓库名（对应 ghcr.io/syan-anan/workbuddy2api-panel:latest）。
GHCR_IMAGE=ghcr.io/your-name/workbuddy2api-panel:latest

# 面板监听端口（宿主机）
PANEL_PORT=7863

# 容器运行用户。挂载目录报 permission denied 时改成 `id -u` / `id -g` 的结果。
PUID=10001
PGID=10001

# 时区
TZ=Asia/Shanghai