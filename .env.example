# 复制成 .env 后按需修改。.env 已被 .gitignore 排除，不会提交。
#   cp .env.example .env

# 预构建镜像地址：填了就 `docker compose pull && docker compose up -d`，不用本地编译。
# 留空则使用本地构建出来的镜像（docker compose up -d --build）。
GHCR_IMAGE=ghcr.io/syan-anan/wb-syan:latest

# 面板 / API 监听端口（宿主机侧，容器内固定 7863）
PANEL_PORT=18888

# 容器运行用户。挂载目录报 permission denied 时改成 `id -u` / `id -g` 的结果。
# 一键部署脚本会自动填成当前用户，手动部署时也可以这么写：
#   PUID=1000
#   PGID=1000
PUID=10001
PGID=10001

# 时区
TZ=Asia/Shanghai