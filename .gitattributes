# 仓库内一律 LF，避免 Windows 检出把 shell 脚本变成 CRLF（容器里会 exec 失败）
* text=auto eol=lf

*.sh      text eol=lf
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
Dockerfile text eol=lf

# 二进制
*.exe     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.gz      binary
*.zip     binary
*.woff2   binary
*.webp    binary
*.woff    binary
*.ttf     binary
*.otf     binary
